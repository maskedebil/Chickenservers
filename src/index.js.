
const ROOM_TTL = 24 * 60 * 60 * 1000;

function makeCode() {
  return Math.random().toString(36).slice(2, 8).toUpperCase();
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (url.pathname === "/api/health") {
      return Response.json({ status: "online" });
    }

    if (url.pathname === "/api/rooms" && request.method === "POST") {
      const code = makeCode();
      const id = env.ROOMS.idFromName(code);
      const room = env.ROOMS.get(id);

      return room.fetch("https://room/create", {
        method: "POST",
        body: JSON.stringify({ code, expires: Date.now() + ROOM_TTL })
      });
    }

    if (url.pathname.startsWith("/api/rooms/")) {
      const code = url.pathname.split("/").pop().toUpperCase();
      const id = env.ROOMS.idFromName(code);
      return env.ROOMS.get(id).fetch(request);
    }

    if (url.pathname.startsWith("/ws/")) {
      const code = url.pathname.split("/").pop().toUpperCase();
      const id = env.ROOMS.idFromName(code);
      return env.ROOMS.get(id).fetch(request);
    }

    return env.ASSETS.fetch(request);
  }
};

export class Room {
  constructor(state) {
    this.state = state;
    this.sockets = new Set();
    this.room = null;
  }

  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === "/create" && request.method === "POST") {
      this.room = await request.json();

      return Response.json({
        success: true,
        code: this.room.code,
        expires: this.room.expires
      });
    }

    if (url.pathname === "/") {
      if (!this.room || Date.now() > this.room.expires) {
        return Response.json({ error: "Комната не найдена или истекла" }, {
          status: 404
        });
      }

      return Response.json(this.room);
    }

    if (url.pathname.startsWith("/ws/")) {
      if (!this.room || Date.now() > this.room.expires) {
        return new Response("Комната истекла", { status: 404 });
      }

      if (request.headers.get("Upgrade") !== "websocket") {
        return new Response("WebSocket required", { status: 426 });
      }

      const pair = new WebSocketPair();
      const client = pair[0];
      const server = pair[1];

      server.accept();
      this.sockets.add(server);

      server.addEventListener("message", event => {
        for (const socket of this.sockets) {
          if (socket !== server) {
            try {
              socket.send(event.data);
            } catch {}
          }
        }
      });

      server.addEventListener("close", () => {
        this.sockets.delete(server);
      });

      server.addEventListener("error", () => {
        this.sockets.delete(server);
      });

      return new Response(null, {
        status: 101,
        webSocket: client
      });
    }

    return new Response("Not found", { status: 404 });
  }
}
