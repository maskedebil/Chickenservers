const ROOM_TTL_SECONDS = 24 * 60 * 60;
const MAX_PEERS = 9;
const MAX_MSG = 64 * 1024;

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { "content-type": "application/json; charset=utf-8", "access-control-allow-origin": "*" }
  });
}

function makeRoomCode() {
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  const bytes = crypto.getRandomValues(new Uint8Array(6));
  return Array.from(bytes, b => chars[b % chars.length]).join("");
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS" && url.pathname.startsWith("/api/")) {
      return new Response(null, { headers: {
        "access-control-allow-origin": "*",
        "access-control-allow-methods": "GET,POST,OPTIONS",
        "access-control-allow-headers": "content-type"
      }});
    }

    if (url.pathname === "/api/health") {
      return json({ ok: true, service: "ChickenStrike2Servers" });
    }

    if (url.pathname === "/api/rooms" && request.method === "POST") {
      const code = makeRoomCode();
      const stub = env.ROOMS.get(env.ROOMS.idFromName(code));
      const result = await stub.fetch("https://room.internal/create", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ code })
      });
      return json(await result.json(), result.status);
    }

    const roomMatch = url.pathname.match(/^\/api\/rooms\/([A-Z0-9]{6})$/i);
    if (roomMatch && request.method === "GET") {
      const code = roomMatch[1].toUpperCase();
      const r = await env.ROOMS.get(env.ROOMS.idFromName(code)).fetch("https://room.internal/info");
      return json(await r.json(), r.status);
    }

    const wsMatch = url.pathname.match(/^\/ws\/([A-Z0-9]{6})$/i);
    if (wsMatch) {
      const code = wsMatch[1].toUpperCase();
      const role = url.searchParams.get("role") === "host" ? "host" : "peer";
      const stub = env.ROOMS.get(env.ROOMS.idFromName(code));
      return stub.fetch(new Request(`https://room.internal/connect?role=${role}`, request));
    }

    if (env.ASSETS) return env.ASSETS.fetch(request);
    return new Response("ChickenStrike2Servers is running", {
      headers: { "content-type": "text/plain; charset=utf-8" }
    });
  }
};

// Комната: хост-авторитетная схема. Хост (один) получает сообщения всех игроков,
// игроки получают только то, что хост отправил им. Сервер ничего не понимает в игре.
export class Room {
  constructor(state, env) {
    this.state = state;
    this.env = env;
    this.host = null;
    this.peers = new Map();
    this.nextPid = 1;
    this.state.blockConcurrencyWhile(async () => {
      this.meta = (await this.state.storage.get("meta")) || null;
    });
  }

  alive() { return this.meta && this.meta.expiresAt > Date.now(); }

  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === "/create" && request.method === "POST") {
      const body = await request.json();
      if (!this.meta) {
        this.meta = {
          code: body.code,
          createdAt: Date.now(),
          expiresAt: Date.now() + ROOM_TTL_SECONDS * 1000
        };
        await this.state.storage.put("meta", this.meta);
        await this.state.storage.setAlarm(this.meta.expiresAt);
      }
      return json({ ok: true, code: this.meta.code, expiresAt: this.meta.expiresAt });
    }

    if (url.pathname === "/info") {
      if (!this.alive()) return json({ ok: false, error: "Room not found or expired" }, 404);
      return json({ ok: true, code: this.meta.code, expiresAt: this.meta.expiresAt, players: this.peers.size, host: !!this.host });
    }

    if (url.pathname === "/connect") {
      if (!this.alive()) return json({ ok: false, error: "Room not found or expired" }, 404);
      if (request.headers.get("Upgrade") !== "websocket") {
        return new Response("WebSocket upgrade required", { status: 426 });
      }
      const role = url.searchParams.get("role");
      const pair = new WebSocketPair();
      const [client, server] = Object.values(pair);
      server.accept();
      if (role === "host") this.attachHost(server); else this.attachPeer(server);
      return new Response(null, { status: 101, webSocket: client });
    }

    return new Response("Not found", { status: 404 });
  }

  send(ws, obj) { try { ws.send(JSON.stringify(obj)); } catch {} }

  attachHost(ws) {
    if (this.host) {
      this.send(ws, { type: "error", msg: "У комнаты уже есть хост" });
      try { ws.close(1008, "host exists"); } catch {}
      return;
    }
    this.host = ws;
    this.send(ws, { type: "hosted", room: this.meta.code });
    ws.addEventListener("message", ev => {
      if (typeof ev.data !== "string" || ev.data.length > MAX_MSG) return;
      let m; try { m = JSON.parse(ev.data); } catch { return; }
      if (m.type !== "to" || typeof m.data !== "string") return;
      const p = this.peers.get(m.to);
      if (p) this.send(p, { type: "data", data: m.data });
    });
    const gone = () => {
      if (this.host !== ws) return;
      this.host = null;
      for (const p of this.peers.values()) {
        this.send(p, { type: "hostleft" });
        try { p.close(1000, "host left"); } catch {}
      }
      this.peers.clear();
    };
    ws.addEventListener("close", gone);
    ws.addEventListener("error", gone);
  }

  attachPeer(ws) {
    if (!this.host) {
      this.send(ws, { type: "error", msg: "Хост ещё не в комнате" });
      try { ws.close(1008, "no host"); } catch {}
      return;
    }
    if (this.peers.size >= MAX_PEERS) {
      this.send(ws, { type: "error", msg: "Комната заполнена" });
      try { ws.close(1008, "full"); } catch {}
      return;
    }
    const pid = this.nextPid++;
    this.peers.set(pid, ws);
    this.send(ws, { type: "joined", pid });
    this.send(this.host, { type: "peer", pid });
    ws.addEventListener("message", ev => {
      if (typeof ev.data !== "string" || ev.data.length > MAX_MSG) return;
      let m; try { m = JSON.parse(ev.data); } catch { return; }
      if (m.type !== "to" || typeof m.data !== "string" || !this.host) return;
      this.send(this.host, { type: "data", from: pid, data: m.data });
    });
    const gone = () => {
      if (this.peers.get(pid) !== ws) return;
      this.peers.delete(pid);
      if (this.host) this.send(this.host, { type: "left", pid });
    };
    ws.addEventListener("close", gone);
    ws.addEventListener("error", gone);
  }

  async alarm() {
    for (const p of this.peers.values()) { try { p.close(1000, "expired"); } catch {} }
    if (this.host) { try { this.host.close(1000, "expired"); } catch {} }
    this.peers.clear(); this.host = null;
    await this.state.storage.deleteAll();
    this.meta = null;
  }
}